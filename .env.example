# The server reads provider credentials; they are never sent to the browser.
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# Optional Anthropic-compatible base URL. Defaults to https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional experiment defaults. Providers: mock, openai, anthropic.
NIRVANA_TARGET_PROVIDER=
NIRVANA_TARGET_MODEL=
NIRVANA_JUDGE_PROVIDER=
NIRVANA_JUDGE_MODEL=
NIRVANA_MOCK_MODEL=nirvana-mock-v1
NIRVANA_REQUEST_TIMEOUT_MS=45000
NIRVANA_MAX_OUTPUT_TOKENS=2048
# Comma-separated browser origins permitted to call the local API.
NIRVANA_ALLOWED_ORIGINS=

# Production bind address and port. Development uses 8787 for the API proxy.
HOST=127.0.0.1
PORT=4173
